# GitHub API token (required for contributions graph in Stack section)
# Create a token at https://github.com/settings/tokens — needs only `read:user` scope
GITHUB_TOKEN=

# Example environment variables for contact form
# Option A: SendGrid (preferred if you have an API key)
SENDGRID_API_KEY=
SENDGRID_FROM=you@yourdomain.com
CONTACT_TO=your@email.com

# Option B: SMTP (requires installing `nodemailer` and valid SMTP creds)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=you@yourdomain.com
SMTP_TO=your@email.com

# Notes:
# - If neither SendGrid nor SMTP are configured, submissions are logged to the server console.
# - Add secrets to a local `.env.local` (do not commit it).
